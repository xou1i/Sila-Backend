# ---- Sila (صِلة) backend configuration ----
# Copy to .env and replace every secret. Never commit .env.

APP_ENV=development

# PostgreSQL (docker compose exposes the DB on host port 5433)
DATABASE_URL=postgresql+psycopg://sila:sila@localhost:5433/sila

# Secrets: 32+ random chars each. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-jwt-secret-change-me-jwt-secret-000
OWNERSHIP_SIGNING_SECRET=change-me-ownership-secret-change-me-000000
QUOTE_SIGNING_SECRET=change-me-quote-secret-change-me-quote-0000

# Auth
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# CORS: comma-separated frontend origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Market data (background job; the API never calls providers per request)
PRICE_REFRESH_SECONDS=60
PRICE_STALE_SECONDS=300
PRICE_FETCH_TIMEOUT_SECONDS=5
GOLD_PRICE_URL=https://api.gold-api.com/price/XAU
FX_RATES_URL=https://open.er-api.com/v6/latest/USD
FALLBACK_XAU_USD_PER_OUNCE=4250.00
FALLBACK_USD_IQD=1310.00
SCHEDULER_ENABLED=true

# Business config (server-side only; the client can never send these)
PROMOTION_FEE_IQD=25000
PROMOTION_DURATION_DAYS=7
SUBSCRIPTION_PRICE_IQD=15000
SUBSCRIPTION_DURATION_DAYS=30
QUOTE_TTL_SECONDS=60
MOCK_PAYMENT_FAIL=false

# Rate limits ("<count>/<second|minute|hour>") per client IP
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_KYC=5/minute
RATE_LIMIT_AI=20/minute

# AI provider (optional). Empty key = deterministic rule-based engine only.
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_TIMEOUT_SECONDS=6
AI_MATCH_MIN_GRAMS=1
